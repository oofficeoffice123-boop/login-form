@model Login_form.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Login Form</title>
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body>
    <main class="auth-page">
        <section class="auth-intro">
            <a class="auth-brand" asp-controller="Account" asp-action="Login">
                <span>Login Form</span>
            </a>
        </section>

        <section class="auth-panel">
            <div class="auth-card">
                <h2>Sign in to your account</h2>

                <form asp-action="Login" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                    <div class="form-field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" autofocus />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" autocomplete="current-password" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>
                    <label class="remember-row">
                        <input asp-for="RememberMe" />
                        <span>Remember me</span>
                    </label>
                    <button class="submit-button" type="submit">Sign in <span aria-hidden="true">→</span></button>
                </form>

                <p class="auth-switch">Don't have an account? <a asp-action="Register">Create one</a></p>
            </div>
        </section>
    </main>
</body>
</html>
