@model Login_form.Models.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Create account";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Login Form</title>
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>
<body>
    <main class="auth-page">
        <section class="auth-intro">
            <a class="auth-brand" asp-controller="Account" asp-action="Login">
                <span>Login Form</span>
            </a>
        </section>

        <section class="auth-panel">
            <div class="auth-card">
                <h2>Create your account</h2>
                <p class="card-description">Set up your account with your email and a password.</p>

                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
                    <div class="form-field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" type="email" autocomplete="email" placeholder="you@example.com" autofocus />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    <div class="form-field">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" autocomplete="new-password" placeholder="At least 8 characters" />
                        <span asp-validation-for="Password" class="field-error"></span>
                        <span class="field-hint">Use at least 8 characters, including a number, an uppercase letter, and a lowercase letter.</span>
                    </div>
                    <div class="form-field">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Enter your password again" />
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>
                    <button class="submit-button" type="submit">Create account <span aria-hidden="true">→</span></button>
                </form>

                <p class="auth-switch">Already have an account? <a asp-action="Login">Sign in</a></p>
            </div>
        </section>
    </main>
</body>
</html>
