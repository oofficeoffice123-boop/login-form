<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Login Form</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="app-nav" aria-label="Main navigation">
            <a class="app-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">L</span>
                <span>Login Form</span>
            </a>
            <div class="app-nav-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-email">@User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="nav-button" type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Sign in</a>
                    <a class="nav-button" asp-controller="Account" asp-action="Register">Create account</a>
                }
            </div>
        </nav>
    </header>
    <div class="page-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

</body>
</html>
